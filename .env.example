# Copia este archivo a .env (excluido por .gitignore) y completa los valores.
# NUNCA subas .env al repositorio. Ver docs/SECRETS.md.
# Generar un valor: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECUREBANK_JWT_SECRET=
# Opcionales: contraseñas de los usuarios demo (si se omiten, se generan al azar
# y no se puede iniciar sesión con alice/bob).
SECUREBANK_DEMO_ALICE_PASSWORD=
SECUREBANK_DEMO_BOB_PASSWORD=
