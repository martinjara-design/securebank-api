# Imagen de referencia para el laboratorio.
# No usar para despliegues.

FROM python:3.11-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY securebank_api/ ./securebank_api/

USER root

EXPOSE 8080 22

CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "1", "--worker-tmp-dir", "/tmp", "securebank_api.app:app"]
